# ==============================================================================
# VerityLens — Environment Configuration Template (.env.example)
# ==============================================================================
#
# NOTICE: This file is a documentation template containing sample placeholder
# values. It is NOT a functioning configuration file and MUST NOT contain real
# credentials, passwords, tokens, or production API keys.
#
# INSTRUCTIONS:
# - For Backend: Copy relevant variables to `backend/.env` (excluded from git).
# - For Frontend: Copy `NEXT_PUBLIC_*` variables to `frontend/.env.local` (excluded from git).
# - NEVER commit real `.env` or `.env.local` files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Backend Service Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=info

# Allowed origins for CORS (comma-separated list for local development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Supabase Persistence, Authentication & Storage (Backend Access)
# ------------------------------------------------------------------------------
# Supabase project URL (used by backend to connect to REST/Storage APIs)
SUPABASE_URL=https://your-project-id.supabase.co

# Backend service-role key for administrative tasks (e.g., storage provisioning).
# CRITICAL SECURITY RULE: This key bypasses RLS and MUST NEVER be exposed to the
# browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key-placeholder

# Supabase Auth JWKS public-key endpoint for cryptographically verifying user access tokens.
# Tokens are verified against project public keys; user_id is derived strictly
# from verified token claims and never from untrusted client input.
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Private Supabase Storage bucket for user PDF documents
SUPABASE_STORAGE_BUCKET=user-documents

# ------------------------------------------------------------------------------
# 3. AI Reasoning Engine (xAI Grok Integration — Backend Only)
# ------------------------------------------------------------------------------
# xAI API Key.
# CRITICAL SECURITY RULE: Must remain strictly on the backend. Never expose to client.
XAI_API_KEY=xai-your-backend-api-key-placeholder

# xAI API Base URL (default is official xAI v1 endpoint)
XAI_BASE_URL=https://api.x.ai/v1

# Configurable xAI model identifier (e.g., grok-beta or current active version).
# NOTE: Model availability and exact identifier must be verified against your xAI account.
XAI_MODEL=grok-beta

# Optional temperature for generation (0.0 for strict deterministic extraction)
XAI_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 4. Semantic Embedding Engine Configuration (Local CPU Inference)
# ------------------------------------------------------------------------------
# Provider: 'local' (SentenceTransformers running on local CPU, verified 384 dimensions)
EMBEDDING_PROVIDER=local

# Model identifier (tested and verified on Python 3.13)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Embedding vector dimension (must match the database pgvector column dimension)
EMBEDDING_DIMENSION=384

# Optional: Hugging Face token to avoid unauthenticated download rate limits
# HF_TOKEN=hf_your_optional_token_placeholder

# ------------------------------------------------------------------------------
# 5. Frontend Next.js Client Configuration (frontend/.env.local)
# ------------------------------------------------------------------------------
# Base URL of the FastAPI backend for client-side API requests
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Public Supabase URL (safe for browser; all queries are governed by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anonymous Key (safe for browser; all queries are governed by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-placeholder
